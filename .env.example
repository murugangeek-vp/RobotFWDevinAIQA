# Copy to .env (never commit the real file). Loader uses RW; verification uses RO.
RECON_RO_USER=recon_ro
RECON_RO_PASSWORD=change-me
RECON_RW_USER=recon_rw
RECON_RW_PASSWORD=change-me

# Phase-1 demo uses local PostgreSQL databases:
#   wdr_uat_active_stage.signature      (CSV landing)
#   wdr_uat_integration.wdr_il_core     (integration core)
#   wdr_uat_consumption.wdr_cl_fds_core (consumption / target)
# For a real UAT run, point the phase1_* env yamls at the client hosts and
# set run.snapshot_id to the agreed frozen migration cut.
