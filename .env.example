# Copy to .env (never commit the real file). Loader uses RW; verification uses RO.
RECON_RO_USER=recon_ro
RECON_RO_PASSWORD=change-me
RECON_RW_USER=recon_rw
RECON_RW_PASSWORD=change-me

# Real Snowflake target (config/environments/webster_santander.yaml, fake: false).
# SNOWFLAKE_ACCOUNT=orgname-accountname
# SNOWFLAKE_USER=recon_user
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=SANTANDER
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_ROLE=RECON_RO

# Live migration run (config/environments/webster_santander_live.yaml).
# snapshot_id names the agreed frozen migration cut — mandatory for real runs.
# MIGRATION_SNAPSHOT_ID=2026-10-10T02:00Z
# SOURCE_PG_HOST=webster-source.example.bank
# SOURCE_PG_PORT=5432
# SOURCE_PG_DATABASE=corebank
# SOURCE_PG_CA_FILE=/path/to/ca-chain.pem   # sslmode: verify-full
