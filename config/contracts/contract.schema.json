{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Reconciliation Contract",
  "type": "object",
  "required": ["contract_name", "version", "source", "target", "keys", "columns"],
  "properties": {
    "contract_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["csv", "s3", "api", "dataiku"]},
        "path": {"type": "string"},
        "encoding": {"type": "string"},
        "delimiter": {"type": "string"},
        "header": {"type": "boolean"},
        "columns": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "bucket": {"type": "string", "minLength": 3},
        "key": {"type": "string", "minLength": 1},
        "prefix": {"type": "string"},
        "suffix": {"type": "string"},
        "format": {"type": "string", "enum": ["csv", "json", "jsonl"]},
        "version_id": {"type": "string"},
        "expected_bucket_owner": {"type": "string", "pattern": "^[0-9]{12}$"},
        "max_objects": {"type": "integer", "minimum": 1},
        "control_file": {
          "type": "string",
          "description": "Bank trailer file (key or path) with declared totals: CSV columns name,group,value"
        },
        "joins": {
          "type": "array",
          "description": "Secondary source files merged onto the main extract before checks (csv sources)",
          "items": {
            "type": "object",
            "required": ["path", "on"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "on": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
                ]
              },
              "how": {"type": "string", "enum": ["left", "inner"]},
              "columns": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1,
                "description": "Expected header of the join file; enforced exactly when present"
              },
              "suffix": {
                "type": "string",
                "description": "Suffix applied to non-key columns that collide with main-file names"
              },
              "require_match": {
                "type": "boolean",
                "description": "Fail the read when a main-file row has no join match"
              }
            }
          }
        }
      }
    },
    "mappings": {
      "type": "object",
      "description": "Code translation tables used by map(column, mapping_name) transforms",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"type": "string"}
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "type": {"type": "string", "enum": ["count", "sum", "min", "max", "null_count", "count_distinct"]},
          "column": {"type": "string"},
          "group_by": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
          "file_name": {
            "type": "string",
            "description": "Name this control has in the bank trailer file (default: id)"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "expected_row_count": {"type": "integer", "minimum": 0},
        "encoding": {"type": "string"},
        "delimiter": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "required": ["type", "table"],
      "properties": {
        "type": {"type": "string", "enum": ["postgres", "snowflake", "mysql"]},
        "schema": {"type": "string"},
        "table": {"type": "string", "minLength": 1}
      }
    },
    "keys": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "nullable"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source_name": {"type": "string"},
          "type": {"type": "string", "enum": ["integer", "decimal", "string", "date", "timestamp", "boolean"]},
          "nullable": {"type": "boolean"},
          "unique": {"type": "boolean"},
          "max_length": {"type": "integer", "minimum": 1},
          "scale": {"type": "integer", "minimum": 0},
          "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "allowed_values": {"type": "array", "items": {}, "minItems": 1},
          "regex": {"type": "string"},
          "date_format": {"type": "string"},
          "ts_format": {"type": "string"},
          "transform": {"type": "string"},
          "pii": {"type": "boolean"}
        }
      }
    }
  }
}
