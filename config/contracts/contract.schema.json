{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data Reconciliation Contract",
  "type": "object",
  "required": ["contract_name", "version", "source", "target", "keys", "columns"],
  "properties": {
    "contract_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["csv", "s3", "api", "dataiku", "postgres", "snowflake", "mysql", "oracle", "mssql"]},
        "path": {"type": "string"},
        "encoding": {"type": "string"},
        "delimiter": {"type": "string"},
        "header": {"type": "boolean"},
        "keep_default_na": {
          "type": "boolean",
          "description": "csv source: true = empty cells become NULL (landing semantics); default false preserves literal empty strings"
        },
        "columns": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "host": {"type": "string", "description": "DB source: server host (postgres)"},
        "port": {"type": "integer"},
        "database": {"type": "string", "description": "DB source: database name"},
        "schema": {"type": "string", "description": "DB source: schema of the source table"},
        "table": {"type": "string", "description": "DB source: source table name"},
        "user": {"type": "string", "description": "DB source: user — use ${ENV_VAR} refs, never literals"},
        "password": {"type": "string", "description": "DB source: password — use ${ENV_VAR} refs, never literals"},
        "where": {"type": "string", "description": "DB source: optional WHERE fragment (vetted read-only)"},
        "batch_size": {"type": "integer", "minimum": 1, "description": "DB source: server-side cursor fetch size for chunked reads"},
        "snapshot": {"type": "string", "description": "DB source: 'exported' pins all sessions to one pg_export_snapshot() (postgres); resolved id is injected, never literal in config"},
        "snapshot_column": {"type": "string", "description": "DB source: watermark column — adds col <= run.snapshot_id as a bound predicate"},
        "snapshot_value": {"type": "string", "description": "DB source: watermark value (set from run.snapshot_id at load; not user-authored)"},
        "bucket": {"type": "string", "minLength": 3},
        "key": {"type": "string", "minLength": 1},
        "prefix": {"type": "string"},
        "suffix": {"type": "string"},
        "format": {"type": "string", "enum": ["csv", "json", "jsonl"]},
        "version_id": {"type": "string"},
        "expected_bucket_owner": {"type": "string", "pattern": "^[0-9]{12}$"},
        "max_objects": {"type": "integer", "minimum": 1},
        "control_file": {
          "type": "string",
          "description": "Bank trailer file (key or path) with declared totals: CSV columns name,group,value"
        },
        "row_filter": {
          "type": "object",
          "description": "Migration scope: only matching source rows are expected in the target — e.g. {column: status, in: [active]}, or {all|any: [predicates]} with ops in|not_in|eq|ne; allow_empty permits a zero-row scope"
        },
        "joins": {
          "type": "array",
          "description": "Secondary source files merged onto the main extract before checks (csv sources)",
          "items": {
            "type": "object",
            "required": ["path", "on"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "on": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
                ]
              },
              "how": {"type": "string", "enum": ["left", "inner"]},
              "columns": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1,
                "description": "Expected header of the join file; enforced exactly when present"
              },
              "suffix": {
                "type": "string",
                "description": "Suffix applied to non-key columns that collide with main-file names"
              },
              "require_match": {
                "type": "boolean",
                "description": "Fail the read when a main-file row has no join match"
              }
            }
          }
        }
      }
    },
    "mappings": {
      "type": "object",
      "description": "Code translation tables used by map(column, mapping_name) transforms",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"type": "string"}
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "type": {"type": "string", "enum": ["count", "sum", "min", "max", "null_count", "count_distinct"]},
          "column": {"type": "string"},
          "group_by": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
          "file_name": {
            "type": "string",
            "description": "Name this control has in the bank trailer file (default: id)"
          },
          "requirement_id": {
            "type": "string",
            "description": "RTM join key — the requirement this control verifies"
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "description": "FK integrity across contracts: child column (this contract) must exist in the parent contract's column — checked on both source and target sides",
      "items": {
        "type": "object",
        "required": ["parent_mapping", "parent_column", "child_column"],
        "additionalProperties": false,
        "properties": {
          "parent_mapping": {"type": "string", "minLength": 1},
          "parent_column": {"type": "string", "minLength": 1},
          "child_column": {"type": "string", "minLength": 1},
          "requirement_id": {
            "type": "string",
            "description": "RTM join key — the requirement this relation verifies"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "expected_row_count": {"type": "integer", "minimum": 0},
        "encoding": {"type": "string"},
        "delimiter": {"type": "string"}
      }
    },
    "params": {
      "type": "object",
      "description": "Declared run parameters (e.g. load_date from run.load_date). Transforms resolve them as __name pseudo-columns — never fetched from the source table",
      "additionalProperties": {"type": "string"}
    },
    "target": {
      "type": "object",
      "required": ["type", "table"],
      "properties": {
        "type": {"type": "string", "enum": ["postgres", "snowflake", "mysql", "oracle", "mssql"]},
        "schema": {"type": "string"},
        "table": {"type": "string", "minLength": 1}
      }
    },
    "recon": {
      "type": "object",
      "description": "Comparison tuning. mode=hash: million-row fast path — compare key->rowhash maps, fetch rows only for differing keys. batch_size bounds memory per fetch.",
      "properties": {
        "mode": {"type": "string", "enum": ["full", "hash"]},
        "batch_size": {"type": "integer", "minimum": 100}
      }
    },
    "keys": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "nullable"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source_name": {"type": "string"},
          "type": {"type": "string", "enum": ["integer", "decimal", "string", "date", "timestamp", "boolean"]},
          "nullable": {"type": "boolean"},
          "unique": {"type": "boolean"},
          "max_length": {"type": "integer", "minimum": 1},
          "scale": {"type": "integer", "minimum": 0},
          "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "allowed_values": {"type": "array", "items": {}, "minItems": 1},
          "regex": {"type": "string"},
          "date_format": {"type": "string"},
          "ts_format": {"type": "string"},
          "transform": {"type": "string"},
          "pii": {"type": "boolean"}
        }
      }
    }
  }
}
