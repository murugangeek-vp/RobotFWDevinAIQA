{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Migration Manifest",
  "type": "object",
  "required": ["migration", "version", "data_classification", "tables"],
  "additionalProperties": false,
  "properties": {
    "migration": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "source_system": {"type": "string"},
    "target_system": {"type": "string"},
    "data_classification": {
      "type": "string",
      "enum": ["synthetic", "internal", "confidential", "restricted"]
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "contract"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "contract": {"type": "string", "minLength": 1},
          "tier": {"type": "string", "enum": ["critical", "standard"]},
          "enabled": {"type": "boolean"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "full_compare": {"type": "boolean"},
          "compare_mode": {"type": "string", "enum": ["auto", "full", "hashed", "none"]}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "child", "column", "parent", "parent_column"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "child": {"type": "string"},
          "column": {"type": "string"},
          "parent": {"type": "string"},
          "parent_column": {"type": "string"}
        }
      }
    }
  }
}
