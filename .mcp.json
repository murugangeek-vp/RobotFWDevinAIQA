{
  "mcpServers": {
    "robotframework": {
      "command": "uvx",
      "args": ["--from", "rf-mcp[database,api]", "robotmcp"]
    },
    "postgres": {
      "command": "docker",
      "args": [
        "run", "-i", "--rm",
        "-e", "DATABASE_URI",
        "mcp/postgres"
      ],
      "env": {
        "DATABASE_URI": "${RECON_RO_DSN}"
      }
    }
  }
}
